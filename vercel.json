{
  "buildCommand": "echo Using committed Pygbag web build",
  "outputDirectory": "web",
  "framework": null,
  "headers": [
    {
      "source": "/(.*).apk",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
